<ENVELOPE>
 <HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Collection</TYPE><ID>PendingBills</ID></HEADER>
 <BODY><DESC>
  <STATICVARIABLES>
   <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
   <SVCURRENTCOMPANY>Demo Traders - 2025-26</SVCURRENTCOMPANY>
  </STATICVARIABLES>
  <TDL><TDLMESSAGE>
   <COLLECTION NAME="PendingBills" ISMODIFY="No">
    <TYPE>Bills</TYPE>
    <FETCH>Name, Parent, BillDate, ClosingBalance, BillCreditPeriod</FETCH>
    <FILTER>IsPending</FILTER>
   </COLLECTION>
   <SYSTEM TYPE="Formulae" NAME="IsPending">NOT $$IsZero:$ClosingBalance</SYSTEM>
  </TDLMESSAGE></TDL>
 </DESC></BODY>
</ENVELOPE>
