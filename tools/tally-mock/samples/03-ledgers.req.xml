<ENVELOPE>
 <HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Collection</TYPE><ID>LedSync</ID></HEADER>
 <BODY><DESC>
  <STATICVARIABLES>
   <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
   <SVCURRENTCOMPANY>Demo Traders - 2025-26</SVCURRENTCOMPANY>
  </STATICVARIABLES>
  <TDL><TDLMESSAGE>
   <COLLECTION NAME="LedSync" ISMODIFY="No">
    <TYPE>Ledger</TYPE>
    <FETCH>Name, GUID, AlterID, Parent, LedStateName, PartyGSTIN, IsBillWiseOn, OpeningBalance, ClosingBalance</FETCH>
    <FILTER>AfterAlter</FILTER>
   </COLLECTION>
   <SYSTEM TYPE="Formulae" NAME="AfterAlter">$AlterID &gt; 0</SYSTEM>
  </TDLMESSAGE></TDL>
 </DESC></BODY>
</ENVELOPE>
