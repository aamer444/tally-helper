<ENVELOPE>
<HEADER>
<VERSION>1</VERSION>
<TALLYREQUEST>EXPORT</TALLYREQUEST>
<TYPE>DATA</TYPE>
<ID>My Ledger Outstandings</ID>
</HEADER>
<BODY>
<DESC>
<STATICVARIABLES>
<SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
<SVCURRENTCOMPANY>{COMPANY}</SVCURRENTCOMPANY>
<LedgerName>6UPI SALES</LedgerName>
<SVFROMDATE TYPE='Date'>20260401</SVFROMDATE>
<SVTODATE TYPE='Date'>20270331</SVTODATE>
<SHOWBYBILL>YES</SHOWBYBILL>
<SHOWBILLTYPE>$$SysName:AllBills</SHOWBILLTYPE>
</STATICVARIABLES>
<TDL>
<TDLMESSAGE>
<REPORT NAME='My Ledger Outstandings' ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No'>
<VARIABLE>SVFROMDATE,SVTODATE,SVCURRENTCOMPANY,ReportTitle,ReportSubTitle</VARIABLE>
<USE>Ledger Outstandings</USE>
<FORMS>Ledger Outstandings</FORMS>
</REPORT>
<LINE ISMODIFY='Yes' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='BILLOnAccDetail'>
<XMLTAG>'ONACCOUNT'</XMLTAG>
<ADD>Explode:BILL OnAccVouchers:Yes</ADD>
</LINE>
<LINE ISMODIFY='Yes' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='BILL InvDetails'>
<Empty>Yes</Empty>
</LINE>
<LINE ISMODIFY='Yes' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='BillOrderDetails'>
<Empty>Yes</Empty>
</LINE>
<LINE ISMODIFY='Yes' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='BILL VchNarr'>
<Empty>Yes</Empty>
</LINE>
</TDLMESSAGE>
</TDL>
</DESC>
</BODY>
</ENVELOPE>
