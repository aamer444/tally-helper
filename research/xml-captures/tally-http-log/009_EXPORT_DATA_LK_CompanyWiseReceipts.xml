<ENVELOPE>
<HEADER>
<VERSION>1</VERSION>
<TALLYREQUEST>Export</TALLYREQUEST>
<TYPE>Data</TYPE>
<ID>LK_CompanyWiseReceipts</ID>
</HEADER>
<BODY>
<DESC>
<STATICVARIABLES>
<SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
<SVFROMDATE TYPE='Date'>20250402</SVFROMDATE>
<SVTODATE TYPE='Date'>20250517</SVTODATE>
<SVCURRENTCOMPANY>{COMPANY}</SVCURRENTCOMPANY>
</STATICVARIABLES>
<TDL>
<TDLMESSAGE>
<REPORT NAME='LK_CompanyWiseReceipts'>
<VARIABLE>SVFROMDATE,SVTODATE,SVCURRENTCOMPANY,ReportTitle,ReportSubTitle</VARIABLE>
<FORMS>LK_CompanyWiseReceipts</FORMS>
</REPORT>
<FORM NAME='LK_CompanyWiseReceipts'>
<TOPPARTS>LK_CompanyWiseReceipts</TOPPARTS>
</FORM>
<PART NAME='LK_CompanyWiseReceipts'>
<TOPLINES>LK_CompanyWiseReceipts</TOPLINES>
<REPEAT>LK_CompanyWiseReceipts : LK_loopReceipts</REPEAT>
<SCROLLED>Vertical</SCROLLED>
</PART>
<PART NAME='ReceiptLedgerDesc'>
<TOPLINES>ReceiptLedgerDesc</TOPLINES>
<REPEAT>ReceiptLedgerDesc:AllLedgerEntries</REPEAT>
</PART>
<PART NAME='GetReceiptCategoryAllocation'>
<TOPLINES>GetReceiptCategoryAllocation</TOPLINES>
<REPEAT>GetReceiptCategoryAllocation:CATEGORYALLOCATIONS</REPEAT>
</PART>
<PART NAME='GetReceiptCostAllocation'>
<TOPLINES>GetReceiptCostAllocation</TOPLINES>
<REPEAT>GetReceiptCostAllocation:COSTCENTREALLOCATIONS</REPEAT>
</PART>
<PART NAME='GetReceiptBillRef'>
<TOPLINES>GetReceiptBillRef</TOPLINES>
<REPEAT>GetReceiptBillRef:billallocations</REPEAT>
</PART>
<PART NAME='GetReceiptBankAllocation'>
<TOPLINES>GetReceiptBankAllocation</TOPLINES>
<REPEAT>GetReceiptBankAllocation:bankallocations</REPEAT>
</PART>
<LINE NAME='LK_CompanyWiseReceipts'>
<LEFTFIELDS>GetRecVchGuid, GetRecVchId,GetRecVchAlterId,GetRecVchType,GetRecVchNo,GetRecVchDate,GetRecVchRefNo, GetRecVchisCancelled,GetRecVchIsOptional,GetRecVchEffecticeDate,GetRecVchVoucherKey, GetRecVchisInvoice,GetRecVchAutoCostLevel,GetRecVchPersistedView,GetRecVchRefDate ,GetRecVchAcc,GetRecVchEntryMode</LEFTFIELDS>
<RIGHTFIELDS>GetRecVchAccPartyGstIn,GetRecVchAccPartyType,GetRecVchAccConsigneeName,GetRecVchAccNarration,GetRecVchisPostDated,GetRecVchPRICELEVEL</RIGHTFIELDS>
<XMLTAG>Voucher</XMLTAG>
<EXPLODE>ReceiptLedgerDesc</EXPLODE>
</LINE>
<LINE NAME='ReceiptLedgerDesc'>
<LEFTFIELDS>GetRecVchLedName, GetRecVchLedIsParty, GetRecVchLedAmount, GetRecVchLEDGSTTYPEOFSUPPLY,GetRecVchAPPROPRIATEFOR,GetRecVchGSTAPPROPRIATETO,GetRecVchEXCISEALLOCTYPE</LEFTFIELDS>
<EXPLODE>GetReceiptBillRef</EXPLODE>
<EXPLODE>GetReceiptBankAllocation</EXPLODE>
<EXPLODE>GetReceiptCategoryAllocation</EXPLODE>
<XMLTAG>LedgerEntries.LIST</XMLTAG>
</LINE>
<LINE NAME='GetReceiptCategoryAllocation'>
<LEFTFIELDS>GetRecVchCATEGORY,GetRecVchISDEEMEDPOSITIVE</LEFTFIELDS>
<XMLTAG>CATEGORYALLOCATIONS.LIST</XMLTAG>
<EXPLODE>GetReceiptCostAllocation</EXPLODE>
</LINE>
<LINE NAME='GetReceiptCostAllocation'>
<LEFTFIELDS>GetRecVchNAME,GetRecVchAMOUNT</LEFTFIELDS>
<XMLTAG>COSTCENTREALLOCATIONS.LIST</XMLTAG>
</LINE>
<LINE NAME='GetReceiptBillRef'>
<LEFTFIELDS>GetReceiptBillRefNAME,GetReceiptBillRefBILLTYPE,GetReceiptBillRefAMOUNT,GetRecVchBILLDATE,GetRecVchBILLID,GetRecVchBILLCREDITPERIOD</LEFTFIELDS>
<XMLTAG>BILLALLOCATIONS.LIST</XMLTAG>
</LINE>
<LINE NAME='GetReceiptBankAllocation'>
<LEFTFIELDS>GetRecVchBADATE,GetRecVchBAINSTRUMENTDATE,GetRecVchBAINSTRUMENTNUMBER,GetRecVchBANAME,GetRecVchISIBankName,GetRecVchBATRANSACTIONTYPE,GetRecVchBAPAYMENTFAVOURING,GetRecVchBAAMOUNT,GetRecVchBRANCHNAME,GetRecVchIFSCODE,GetRecVchACCOUNTNUMBER,GetRecVchMICRCODE,GetRecVchPAYMENTGATEWAY,GetRecVchTRANSACTIONNAME,GetRecVchACCOUNTTYPE,GetRecVchDELIVERYMODE,GetRecVchDELIVERYTO,GetRecVchBANKCODE,GetRecVchCARDNUMBER,GetRecVchTRANSFERMODE</LEFTFIELDS>
<XMLTAG>bankallocations.LIST</XMLTAG>
</LINE>
<FIELD NAME='GetRecVchGuid'>
<SET>$GUID</SET>
<XMLTAG>GUID</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchId'>
<SET>$MasterID</SET>
<XMLTAG>MasterID</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchType'>
<SET>$VoucherTypeName</SET>
<XMLTAG>VoucherTypeName</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchNo'>
<SET>$VoucherNumber</SET>
<XMLTAG>VoucherNumber</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchDate'>
<SET>$$DDMMYYYYDateFormat:$Date:'-'</SET>
<XMLTAG>Date</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchRefNo'>
<SET>$Reference</SET>
<XMLTAG>Reference</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchisCancelled'>
<SET>$ISCANCELLED</SET>
<XMLTAG>ISCANCELLED</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchIsOptional'>
<SET>$ISOPTIONAL</SET>
<XMLTAG>ISOPTIONAL</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchEffecticeDate'>
<SET>$$DDMMYYYYDateFormat:$EFFECTIVEDATE:'-'</SET>
<XMLTAG>EFFECTIVEDATE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchVoucherKey'>
<SET>$VoucherKey</SET>
<XMLTAG>VOUCHERKEY</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchisInvoice'>
<SET>$ISINVOICE</SET>
<XMLTAG>ISINVOICE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAutoCostLevel'>
<SET>$AUTOCOSTLEVEL</SET>
<XMLTAG>AUTOCOSTLEVEL</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchPersistedView'>
<SET>$PERSISTEDVIEW</SET>
<XMLTAG>PERSISTEDVIEW</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchRefDate'>
<SET>$$DDMMYYYYDateFormat:$ReferenceDate:'-'</SET>
<XMLTAG>ReferenceDate</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAcc'>
<SET>$PartyLedgerName</SET>
<XMLTAG>PartyLedgerName</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAccPartyGstIn'>
<SET>If $$IsEmpty:$Partygstin then $partygstin:Ledger:$PartyLedgerName else $Partygstin</SET>
<XMLTAG>PARTYGSTIN</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAccPartyType'>
<SET>If $$IsEmpty:$GSTRegistrationType then $GSTRegistrationType:Ledger:$PartyLedgerName else $GSTRegistrationType</SET>
<XMLTAG>GSTRegistrationType</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAccConsigneeName'>
<SET>$BasicBuyerName</SET>
<XMLTAG>BasicBuyerName</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAccNarration'>
<SET>$Narration</SET>
<XMLTAG>Narration</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchLedName'>
<SET>$LedgerName</SET>
<XMLTAG>Ledgername</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchLedIsParty'>
<SET>$IsPartyLedger</SET>
<XMLTAG>ISPARTYLEDGER</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchEXCISEALLOCTYPE'>
<SET>$EXCISEALLOCTYPE:$LEDGER:$LEDGERNAME</SET>
<XMLTAG>EXCISEALLOCTYPE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchLedAmount'>
<USE>amount Field</USE>
<SET>$Amount</SET>
<XMLTAG>AMOUNT</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchLEDGSTTYPEOFSUPPLY'>
<SET>$GSTTYPEOFSUPPLY</SET>
<XMLTAG>GSTTYPEOFSUPPLY</XMLTAG>
</FIELD>
<FIELD NAME='GetReceiptBillRefNAME'>
<SET>$Name</SET>
<XMLTAG>NAME</XMLTAG>
</FIELD>
<FIELD NAME='GetReceiptBillRefBILLTYPE'>
<SET>$billtype</SET>
<XMLTAG>BILLTYPE</XMLTAG>
</FIELD>
<FIELD NAME='GetReceiptBillRefAMOUNT'>
<USE>amount field</USE>
<SET>$Amount</SET>
<XMLTAG>AMOUNT</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBADATE'>
<XMLTAG>DATE</XMLTAG>
<SET>$$DDMMYYYYDateFormat:$DATE:'-'</SET>
</FIELD>
<FIELD NAME='GetRecVchBAINSTRUMENTDATE'>
<SET>$$DDMMYYYYDateFormat:$INSTRUMENTDATE:'-'</SET>
<XMLTAG>INSTRUMENTDATE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBAINSTRUMENTNUMBER'>
<SET>$INSTRUMENTNUMBER</SET>
<XMLTAG>INSTRUMENTNUMBER</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBANAME'>
<SET>$NAME</SET>
<XMLTAG>NAME</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchISIBankName'>
<USE>Name Field</USE>
<SET>$BANKNAME</SET>
<XMLTAG>bankname</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBATRANSACTIONTYPE'>
<SET>if $$IsEmpty:@mvalue or $$sysname:NotApplicable = @mvalue then &quot;&quot; else @mvalue</SET>
<LOCALFORMULA>mvalue :$TRANSACTIONTYPE</LOCALFORMULA>
<XMLTAG>TRANSACTIONTYPE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBAPAYMENTFAVOURING'>
<SET>$PAYMENTFAVOURING</SET>
<XMLTAG>PAYMENTFAVOURING</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBAAMOUNT'>
<USE>amount Field</USE>
<SET>$AMOUNT</SET>
<XMLTAG>AMOUNT</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchName'>
<SET>$NAME</SET>
<XMLTAG>NAME</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAmount'>
<USE>amount Field</USE>
<SET>$AMOUNT</SET>
<XMLTAG>AMOUNT</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBranchname'>
<SET>$BRANCHNAME</SET>
<XMLTAG>BRANCHNAME</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchPRICELEVEL'>
<XMLTAG>PRICELEVEL</XMLTAG>
<SET>$PRICELEVEL</SET>
</FIELD>
<FIELD NAME='GetRecVchISDEEMEDPOSITIVE'>
<SET>$ISDEEMEDPOSITIVE</SET>
<XMLTAG>ISDEEMEDPOSITIVE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAppropriatefor'>
<SET>if $$IsEmpty:@mvalue or $$sysname:NotApplicable = @mvalue then &quot;&quot; else @mvalue</SET>
<LOCALFORMULA>mvalue :$APPROPRIATEFOR:Ledger:$LedgerName</LOCALFORMULA>
<XMLTAG>APPROPRIATEFOR</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchGstappropriateto'>
<SET>$GSTAPPROPRIATETO:Ledger:$LedgerName</SET>
<XMLTAG>GSTAPPROPRIATETO</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchCategory'>
<SET>$CATEGORY</SET>
<XMLTAG>CATEGORY</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchisPostDated'>
<SET>$ISPOSTDATED</SET>
<XMLTAG>ISPOSTDATED</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchAlterId'>
<SET>$AlterID</SET>
<XMLTAG>AlterID</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchIFSCODE'>
<SET>$IFSCODE</SET>
<XMLTAG>IFSCODE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchACCOUNTNUMBER'>
<SET>$ACCOUNTNUMBER</SET>
<XMLTAG>ACCOUNTNUMBER</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBILLDATE'>
<SET>$$DDMMYYYYDateFormat:$BILLDATE:'-'</SET>
<XMLTAG>BILLDATE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBILLID'>
<SET>$BILLID</SET>
<XMLTAG>BILLID</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBILLCREDITPERIOD'>
<SET>$BILLCREDITPERIOD</SET>
<XMLTAG>BILLCREDITPERIOD</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchMICRCODE'>
<SET>$MICRCODE</SET>
<XMLTAG>MICRCODE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchPAYMENTGATEWAY'>
<SET>$PAYMENTGATEWAY</SET>
<XMLTAG>PAYMENTGATEWAY</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchTRANSACTIONNAME'>
<SET>$TRANSACTIONNAME</SET>
<XMLTAG>TRANSACTIONNAME</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchACCOUNTTYPE'>
<SET>$ACCOUNTTYPE</SET>
<XMLTAG>ACCOUNTTYPE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchDELIVERYMODE'>
<SET>$DELIVERYMODE</SET>
<XMLTAG>DELIVERYMODE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchDELIVERYTO'>
<SET>$DELIVERYTO</SET>
<XMLTAG>DELIVERYTO</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchBANKCODE'>
<SET>$BANKCODE</SET>
<XMLTAG>BANKCODE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchCARDNUMBER'>
<SET>$CARDNUMBER</SET>
<XMLTAG>CARDNUMBER</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchTRANSFERMODE'>
<SET>$TRANSFERMODE</SET>
<XMLTAG>TRANSFERMODE</XMLTAG>
</FIELD>
<FIELD NAME='GetRecVchEntryMode'>
<SET>$vchentrymode</SET>
<XMLTAG>VCHENTRYMODE</XMLTAG>
</FIELD>
<COLLECTION NAME='LK_loopReceipts'>
<TYPE>vouchers:vouchertype</TYPE>
<CHILDOF>$$VchTypeReceipt</CHILDOF>
<BELONGSTO>Yes</BELONGSTO>
<NATIVEMETHOD>VOUCHERNUMBER,ISCANCELLED,ISOPTIONAL,ISPOSTDATED,DATE,EFFECTIVEDATE,VOUCHERTYPENAME,MASTERID,VOUCHERKEY,GUID,NARRATION,ALTERID,PARTYLEDGERNAME,REFERENCE,REFERENCEDATE,ISINVOICE,PARTYNAME,VCHENTRYMODE,InventoryEntries.*,AllLedgerEntries.*</NATIVEMETHOD>
<FILTER>AlterIdFilterNew</FILTER>
</COLLECTION>
<SYSTEM TYPE='FORMULAE' NAME='AlterIdFilterNew'>$AlterId &lt; 89974 AND $AlterId &gt; 88609</SYSTEM>
</TDLMESSAGE>
</TDL>
</DESC>
</BODY>
</ENVELOPE>
