<ENVELOPE>
<HEADER>
<VERSION>1</VERSION>
<TALLYREQUEST>Export</TALLYREQUEST>
<TYPE>Data</TYPE>
<ID>ListOfVouchers</ID>
</HEADER>
<BODY>
<DESC>
<STATICVARIABLES>
<SVFROMDATE TYPE='Date'>20250401</SVFROMDATE>
<SVTODATE TYPE='Date'>20260331</SVTODATE>
</STATICVARIABLES>
<TDL>
<TDLMESSAGE>
<REPORT ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='ListOfVouchers'>
<VARIABLE>SVEXPORTFORMAT,SVCURRENTCOMPANY,SVFROMDATE,SVTODATE,ReportTitle,ReportSubTitle</VARIABLE>
<FORMS>ListOfVouchers</FORMS>
<SET>SVEXPORTFORMAT:$$SysName:XML</SET>
<SET>SVCURRENTCOMPANY:'{COMPANY}'</SET>
</REPORT>
<FORM ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='ListOfVouchers'>
<TOPPARTS>ListOfVouchers</TOPPARTS>
<XMLTAG>ListOfVouchers</XMLTAG>
</FORM>
<PART ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='ListOfVouchers'>
<TOPLINES>ListOfVouchers</TOPLINES>
<REPEAT>ListOfVouchers : FormListOfVouchers</REPEAT>
<SCROLLED>Vertical</SCROLLED>
</PART>
<LINE ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='ListOfVouchers'>
<FIELDS>LK_Date</FIELDS>
<FIELDS>ALTERID</FIELDS>
<FIELDS>LK_VoucherTypeName</FIELDS>
</LINE>
<FIELD ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='LK_Date'>
<SET>$Date</SET>
<XMLTAG>Date</XMLTAG>
</FIELD>
<FIELD ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='ALTERID'>
<SET>$ALTERID</SET>
<XMLTAG>ALTERID</XMLTAG>
</FIELD>
<FIELD ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='LK_VoucherTypeName'>
<SET>$ReservedName:VoucherType:($parent:VoucherType:$VOUCHERTYPENAME)</SET>
<XMLTAG>VOUCHERTYPENAME</XMLTAG>
</FIELD>
<COLLECTION ISMODIFY='No' ISFIXED='No' ISINITIALIZE='No' ISOPTION='No' ISINTERNAL='No' NAME='FormListOfVouchers'>
<TYPE>vouchers</TYPE>
<NATIVEMETHOD>ALTERID</NATIVEMETHOD>
<FILTER>filterAlterID</FILTER>
</COLLECTION>
<SYSTEM TYPE='FORMULAE' NAME='filterAlterID'>$AlterId &lt; 102814 AND $AlterId &gt; 0</SYSTEM>
</TDLMESSAGE>
</TDL>
</DESC>
</BODY>
</ENVELOPE>
