<ENVELOPE>
<HEADER>
<VERSION>1</VERSION>
<TALLYREQUEST>Export</TALLYREQUEST>
<TYPE>Data</TYPE>
<ID>LK_CompanyInvvch</ID>
</HEADER>
<BODY>
<DESC>
<STATICVARIABLES>
<SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
<SVFROMDATE TYPE='Date'>20250523</SVFROMDATE>
<SVTODATE TYPE='Date'>20260610</SVTODATE>
<SVCURRENTCOMPANY>{COMPANY}</SVCURRENTCOMPANY>
</STATICVARIABLES>
<TDL>
<TDLMESSAGE>
<REPORT NAME='LK_CompanyInvvch'>
<VARIABLE>SVFROMDATE,SVTODATE,SVCURRENTCOMPANY,ReportTitle,ReportSubTitle</VARIABLE>
<FORMS>LK_CompanyInvvch</FORMS>
</REPORT>
<FORM NAME='LK_CompanyInvvch'>
<TOPPARTS>LK_CompanyInvvch</TOPPARTS>
</FORM>
<PART NAME='LK_CompanyInvvch'>
<TOPLINES>LK_CompanyInvvch</TOPLINES>
<REPEAT>LK_CompanyInvvch:LK_loopSales</REPEAT>
<SCROLLED>Vertical</SCROLLED>
</PART>
<PART NAME='SalesItemDesc'>
<TOPLINES>SalesItemDesc</TOPLINES>
<REPEAT>SalesItemDesc:InventoryEntriesin</REPEAT>
</PART>
<PART NAME='SalesItemDescout'>
<TOPLINES>SalesItemDescout</TOPLINES>
<REPEAT>SalesItemDescout:InventoryEntriesout</REPEAT>
</PART>
<PART NAME='SALESBATCHDESC'>
<TOPLINES>SALESBATCHDESC</TOPLINES>
<REPEAT>SALESBATCHDESC: BatchAllocations</REPEAT>
</PART>
<PART NAME='SALESITEMBASICDES'>
<TOPLINES>SALESITEMBASICDES</TOPLINES>
</PART>
<LINE NAME='LK_CompanyInvvch'>
<LEFTFIELDS>SLVCHGUID,SLVCHALTERID, SLVCHID,SLVCHTYPE,SLVCHVOUCHERNUMBER,SLVCHVOUCHERDATE,SLVCHREFERENCENUMBER, SLVCHISCANCELLED,SLVCHISOPTIONAL,SLVCHEFFECTIVEDATE,SLVCHVOUCHERKEY,SLVCHISINVOICE,SLVCHEntryMode,SLVCHPERSISTEDVIEW,SLVCHACCNARRATION</LEFTFIELDS>
<XMLTAG>Voucher</XMLTAG>
<EXPLODE>SalesItemDesc</EXPLODE>
<EXPLODE>SalesItemDescout</EXPLODE>
</LINE>
<LINE NAME='SalesItemDesc'>
<LEFTFIELDS>SLVCHINVNAME,SLVCHINVACCQTY,SLVCHINVBILLEDQTY, SLVCHINVRATE,SLVCHINVDISC,SLVCHINVAMOUNT,SLVCHISDEEMEDPOSITIVE,SLVCHBASICPACKAGEMARKS</LEFTFIELDS>
<EXPLODE>SALESITEMBASICDES</EXPLODE>
<EXPLODE>SALESBATCHDESC</EXPLODE>
<XMLTAG>InventoryEntriesIn.LIST</XMLTAG>
</LINE>
<LINE NAME='SalesItemDescout'>
<LEFTFIELDS>SLVCHINVNAME,SLVCHINVACCQTY,SLVCHINVBILLEDQTY, SLVCHINVRATE,SLVCHINVDISC,SLVCHINVAMOUNT,SLVCHISDEEMEDPOSITIVE,SLVCHBASICPACKAGEMARKS</LEFTFIELDS>
<EXPLODE>SALESITEMBASICDES</EXPLODE>
<EXPLODE>SALESBATCHDESC</EXPLODE>
<XMLTAG>InventoryEntriesOut.LIST</XMLTAG>
</LINE>
<LINE NAME='SALESBATCHDESC'>
<LEFTFIELDS>SLVCHBATGODOWNNAME,SLVCHBATNAME,SLVCHBATQTY,SLVCHACTUALQTY,SLVCHBATAMOUNT,SLVCHORDERNO,SLVCHORDERDUEDATE,SLVCHORDERTYPE,SLVCHDISCOUNT,SLVCHMFDON,SLVCHEXPIRYPERIOD,SLVCHTRACKID,SLVCHBATCHID,SLVCHBATCHINCLVATRATE,SLVCHTRACKINGNUMBER</LEFTFIELDS>
<XMLTAG>BatchAllocations.LIST</XMLTAG>
</LINE>
<LINE NAME='SALESITEMBASICDES'>
<LEFTFIELDS>SLVCHBASICUSERDESCRIPTION</LEFTFIELDS>
<REPEAT>SLVCHBASICUSERDESCRIPTION:BASICUSERDESCRIPTION</REPEAT>
<XMLTAG>BASICUSERDESCRIPTION.list</XMLTAG>
</LINE>
<LINE NAME='SALESLEDGERUSERDESC'>
<LEFTFIELDS>SLVCHLEDGERDESCR</LEFTFIELDS>
<REPEAT>SLVCHLEDGERDESCR:USERDESCRIPTION</REPEAT>
<XMLTAG>USERDESCRIPTION.list</XMLTAG>
</LINE>
<FIELD NAME='SLVCHGUID'>
<SET>$GUID</SET>
<XMLTAG>GUID</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHID'>
<SET>$MasterID</SET>
<XMLTAG>MasterID</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHTYPE'>
<SET>$VoucherTypeName</SET>
<XMLTAG>VoucherTypeName</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHVOUCHERNUMBER'>
<SET>$VoucherNumber</SET>
<XMLTAG>VoucherNumber</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHVOUCHERDATE'>
<SET>$$DDMMYYYYDateFormat:$Date:'-'</SET>
<XMLTAG>Date</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHREFERENCENUMBER'>
<SET>$Reference</SET>
<XMLTAG>Reference</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHISCANCELLED'>
<SET>$ISCANCELLED</SET>
<XMLTAG>ISCANCELLED</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHISOPTIONAL'>
<SET>$ISOPTIONAL</SET>
<XMLTAG>ISOPTIONAL</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHEFFECTIVEDATE'>
<SET>$$DDMMYYYYDateFormat:$EFFECTIVEDATE:'-'</SET>
<XMLTAG>EFFECTIVEDATE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHVOUCHERKEY'>
<USE>name Field</USE>
<SET>$VOUCHERKEY</SET>
<XMLTAG>VOUCHERKEY</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHISINVOICE'>
<SET>$ISINVOICE</SET>
<XMLTAG>ISINVOICE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHEntryMode'>
<SET>$VCHENTRYMODE</SET>
<XMLTAG>VCHENTRYMODE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHPERSISTEDVIEW'>
<SET>$PERSISTEDVIEW</SET>
<XMLTAG>PERSISTEDVIEW</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHACCNARRATION'>
<SET>$Narration</SET>
<XMLTAG>Narration</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHINVNAME'>
<SET>$StockItemName</SET>
<XMLTAG>STOCKITEMNAME</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHINVACCQTY'>
<SET>If @@NoAltUnits then $$String:@Lk_ActualQty:'NoComma' Else if Not $$IsEmpty:@Lk_ActualQty Then $$String:@Lk_ActualQty:'NoComma'+' = '+$$String:@Lk_AltActualQty:'NoComma' Else ''</SET>
<LOCALFORMULA>Lk_ActualQty:$ActualQty</LOCALFORMULA>
<LOCALFORMULA>Lk_AltActualQty:($$AltBase:Yes:$ActualQty)</LOCALFORMULA>
<XMLTAG>ActualQty</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHINVBILLEDQTY'>
<SET>If @@NoAltUnits then $$String:@Lk_BilledQty:'NoComma' Else if Not $$IsEmpty:@Lk_BilledQty Then $$String:@Lk_BilledQty:'NoComma'+' = '+$$String:@Lk_AltBilledQty:'NoComma' Else ''</SET>
<LOCALFORMULA>Lk_BilledQty:$BilledQty</LOCALFORMULA>
<LOCALFORMULA>Lk_AltBilledQty:($$AltBase:Yes:$BilledQty)</LOCALFORMULA>
<XMLTAG>billedqty</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHINVRATE'>
<TYPE>RATE</TYPE>
<SET>$Rate</SET>
<XMLTAG>RATE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHINVDISC'>
<SET>$Discount</SET>
<XMLTAG>DISCOUNT</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHINVAMOUNT'>
<USE>Amount field</USE>
<SET>$Amount</SET>
<XMLTAG>AMOUNT</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHMRPRATECAL'>
<SET>$MRPrate</SET>
<XMLTAG>MRPrate</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBATGODOWNNAME'>
<SET>$GodownName</SET>
<XMLTAG>GODOWNNAME</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBATNAME'>
<SET>$BatchName</SET>
<XMLTAG>batchname</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBATQTY'>
<SET>If @@NoAltUnits then $$String:@Lk_BilledQty:'NoComma' Else if Not $$IsEmpty:@Lk_BilledQty Then $$String:@Lk_BilledQty:'NoComma'+' = '+$$String:@Lk_AltBilledQty:'NoComma' Else ''</SET>
<LOCALFORMULA>Lk_BilledQty:$BilledQty</LOCALFORMULA>
<LOCALFORMULA>Lk_AltBilledQty:($$AltBase:Yes:$BilledQty)</LOCALFORMULA>
<XMLTAG>billedqty</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHACTUALQTY'>
<SET>If @@NoAltUnits then $$String:@Lk_ActualQty:'NoComma' Else if Not $$IsEmpty:@Lk_ActualQty Then $$String:@Lk_ActualQty:'NoComma'+' = '+$$String:@Lk_AltActualQty:'NoComma' Else ''</SET>
<LOCALFORMULA>Lk_ActualQty:$ActualQty</LOCALFORMULA>
<LOCALFORMULA>Lk_AltActualQty:($$AltBase:Yes:$ActualQty)</LOCALFORMULA>
<XMLTAG>Actualqty</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBATAMOUNT'>
<USE>Amount field</USE>
<SET>$Amount</SET>
<XMLTAG>AMOUNT</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHACCLEDAMOUNT'>
<USE>Amount Field</USE>
<SET>$Amount</SET>
<XMLTAG>AMOUNT</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHISDEEMEDPOSITIVE'>
<SET>$ISDEEMEDPOSITIVE</SET>
<XMLTAG>ISDEEMEDPOSITIVE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHCATEGORY'>
<SET>$CATEGORY</SET>
<XMLTAG>CATEGORY</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHEWAYISCANCELLED'>
<SET>$ISCANCELLED</SET>
<XMLTAG>ISCANCELLED</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHIGNOREGSTINVALIDATION'>
<SET>$IGNOREGSTINVALIDATION</SET>
<XMLTAG>IGNOREGSTINVALIDATION</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBASICNUMPACKAGES'>
<SET>$BASICNUMPACKAGES</SET>
<XMLTAG>BASICNUMPACKAGES</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBASICUSERDESCRIPTION'>
<SET>$BASICUSERDESCRIPTION</SET>
<XMLTAG>BASICUSERDESCRIPTION</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHINCLVATRATE'>
<SET>$INCLVATRATE</SET>
<XMLTAG>INCLVATRATE</XMLTAG>
</FIELD>
<FIELD NAME='SALESEWAYCONSIGNORADDRESS'>
<SET>$CONSIGNORADDRESS</SET>
<XMLTAG>CONSIGNORADDRESS</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHCONSIGNORPINCODE'>
<SET>$CONSIGNORPINCODE</SET>
<XMLTAG>CONSIGNORPINCODE</XMLTAG>
</FIELD>
<FIELD NAME='SALESEWAYCONSIGNEEADDRESS'>
<SET>$CONSIGNEEADDRESS</SET>
<XMLTAG>CONSIGNEEADDRESS</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHALTERID'>
<SET>$AlterID</SET>
<XMLTAG>AlterID</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHDISCOUNT'>
<SET>$BATCHDISCOUNT</SET>
<XMLTAG>BATCHDISCOUNT</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHORDERTYPE'>
<SET>$ORDERTYPE</SET>
<XMLTAG>ORDERTYPE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHORDERDUEDATE'>
<SET>$$DDMMYYYYDateFormat:$ORDERDUEDATE:'-'</SET>
<XMLTAG>ORDERDUEDATE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHTRACKINGNUMBER'>
<SET>$TRACKINGNUMBER</SET>
<XMLTAG>TRACKINGNUMBER</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHORDERNO'>
<SET>$ORDERNO</SET>
<XMLTAG>ORDERNO</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHMFDON'>
<SET>$MFDON</SET>
<XMLTAG>MFDON</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHEXPIRYPERIOD'>
<SET>$EXPIRYPERIOD</SET>
<XMLTAG>EXPIRYPERIOD</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHTRACKID'>
<SET>$TRACKID</SET>
<XMLTAG>TRACKID</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBATCHID'>
<SET>$BATCHID</SET>
<XMLTAG>BATCHID</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBATCHINCLVATRATE'>
<SET>$INCLVATRATE</SET>
<XMLTAG>INCLVATRATE</XMLTAG>
</FIELD>
<FIELD NAME='SLVCHBASICPACKAGEMARKS'>
<SET>$BASICPACKAGEMARKS</SET>
<XMLTAG>BASICPACKAGEMARKS</XMLTAG>
</FIELD>
<COLLECTION NAME='LK_loopSales'>
<TYPE>vouchers:vouchertype</TYPE>
<CHILDOF>$$VchTypeStockJrnl</CHILDOF>
<BELONGSTO>Yes</BELONGSTO>
<NATIVEMETHOD>InventoryEntriesIn.*,InventoryEntriesOut.*</NATIVEMETHOD>
<NATIVEMETHOD>VOUCHERNUMBER,ISCANCELLED,ISOPTIONAL,DATE,EFFECTIVEDATE,VOUCHERTYPENAME,MASTERID,VOUCHERKEY,GUID,NARRATION,ALTERID,ISINVOICE,PERSISTEDVIEW,VCHENTRYMODE</NATIVEMETHOD>
<FILTER>AlterIdFilterNew</FILTER>
</COLLECTION>
<SYSTEM TYPE='FORMULAE' NAME='AlterIdFilterNew'>$AlterId &lt; 92713 AND $AlterId &gt; 92711</SYSTEM>
</TDLMESSAGE>
</TDL>
</DESC>
</BODY>
</ENVELOPE>
