{
  "name": "tally-helper",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @th/tally-mock --filter @th/desktop dev",
