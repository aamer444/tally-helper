{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Network access is limited to Tally on this PC (docs/13); updates come from the project's GitHub releases.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }]
    }
  ]
}
